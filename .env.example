# NeuroWeave Knowledge Graph - Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (Required for knowledge graph generation)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Token (Optional - improves GitHub API rate limits and enables private repo access)
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Docker Configuration
COMPOSE_PROJECT_NAME=neuroweave