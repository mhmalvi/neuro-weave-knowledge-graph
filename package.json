{
  "name": "neuroweave-mcp-server",
  "version": "1.0.0",
  "description": "NeuroWeave Knowledge Graph MCP Server - Remote deployment",
  "main": "api/index.py",
  "scripts": {
    "dev": "vercel dev",
    "build": "echo Building Python dependencies...",
    "deploy": "vercel --prod",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test -g \"@smoke\"",
    "test:mcp": "playwright test tests/e2e/mcp-server.spec.ts --project=chromium",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "keywords": [
    "mcp",
    "codebase",
    "analysis",
    "knowledge-graph",
    "vercel"
  ],
  "author": "mhmalvi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhmalvi/neuro-weave-knowledge-graph.git"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "dotenv": "^17.2.2"
  }
}
